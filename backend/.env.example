# AI-Sentinel — ejemplo de configuracion
# Copia este archivo a .env y completa los valores reales.
# IMPORTANTE: nunca comitees un .env con secretos reales.

# --- Obligatorio en produccion ---
# Genera uno aleatorio, ej: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ADMIN_PASSWORD=

# --- Stripe / billing (SOLO TEST mode; los gestiona el equipo de billing) ---
# NUNCA uses claves live de Stripe en este proyecto.
# 1. Crea una cuenta en https://dashboard.stripe.com/test y copia la clave
#    secreta de TEST (empieza con sk_test_...).
# 2. Para el webhook local ejecuta:  stripe listen --forward-to localhost:8000/api/v1/billing/webhook
#    y copia el signing secret que imprime (empieza con whsec_...).
# 3. STRIPE_PRICE_ID es OPCIONAL: si lo dejas vacio, el backend busca (o crea)
#    el producto "CENTINELA Pro" (USD 16/mes recurrente) en tu cuenta TEST y
#    registra el price ID en los logs para que lo pegues aqui.
# 4. BILLING_ENFORCE=true exige trial vigente o suscripcion en los endpoints
#    de analisis/chat/dashboard. Con false, cualquier usuario logueado pasa.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# BILLING_ENFORCE=true

# --- Integraciones opcionales ---
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
OPENAI_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
NUMVERIFY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
FRONTEND_URL=http://localhost:3000

# --- Servidor ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
